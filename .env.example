# =============================================================================
# AI Creative Director -- environment configuration
# Copy this file to `.env` and adjust for your machine. Every value has a
# working default; you only need to change what your hardware/setup requires.
# =============================================================================

# --- LLM (Ollama) -----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.7
OLLAMA_REQUEST_TIMEOUT=120
# Lower-VRAM alternative: OLLAMA_MODEL=gemma3:4b

# --- Image generation backend ------------------------------------------------
# "diffusers" (local HF Diffusers) or "comfyui" (external ComfyUI server)
IMAGE_BACKEND=diffusers

# Diffusers settings
IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
IMAGE_DEVICE=cuda
IMAGE_DTYPE=float16
IMAGE_HEIGHT=1024
IMAGE_WIDTH=1024
IMAGE_NUM_INFERENCE_STEPS=30
IMAGE_GUIDANCE_SCALE=7.5
# Only needed for gated HF models:
HF_TOKEN=

# ComfyUI settings (only used if IMAGE_BACKEND=comfyui)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=

# --- Generation / evaluation loop -------------------------------------------
QUALITY_THRESHOLD=0.75
MAX_GENERATION_ATTEMPTS=3
CANDIDATES_PER_ASSET=3

# --- Orchestration ------------------------------------------------------------
# "crewai" or "langgraph" -- see README for how they divide responsibilities
ORCHESTRATION_FRAMEWORK=crewai

# CrewAI sends anonymous telemetry to telemetry.crewai.com by default; this
# project disables it by default (config/settings.py sets this if unset) so
# "runs fully locally" is actually true. Set to false to re-enable it.
# OTEL_SDK_DISABLED=true

# --- RAG (optional brand knowledge base) -------------------------------------
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_VECTOR_STORE_PATH=outputs/.brand_kb

# --- Output / logging ---------------------------------------------------------
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
